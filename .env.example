VITE_REPO_OWNER=your-github-owner
VITE_REPO_NAME=your-repo-name

# 認証方式: pat | oauth | both (デフォルト: pat)
VITE_AUTH_MODE=pat
# GitHub Apps 認証 (VITE_AUTH_MODE が oauth または both の場合に必要)
# VITE_GITHUB_CLIENT_ID=Iv23lixxxxxxxxxx
# VITE_OAUTH_PROXY_URL=https://your-proxy.workers.dev

# base path の上書き (通常は VITE_REPO_NAME から自動生成)
# 組織の Pages ドメイン (xxx.pages.github.io) ではルートにデプロイされるため / を指定
# VITE_BASE_PATH=/
